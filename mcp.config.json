{
  "mcpServers": {
    "context7": {
      "enabled": true,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "atlassian": {
      "enabled": true,
      "transport": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {
        "Authorization": "Basic ${basic:JIRA_EMAIL:JIRA_TOKEN}",
        "Content-Type": "application/json"
      }
    }
  }
}
