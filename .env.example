# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=

# Logging: WARNING (default, summaries only), DEBUG (repo scan / health-check detail)
# LOG_LEVEL=WARNING
# OPENHANDS_SUPPRESS_BANNER=1

# LLM Configuration (Omlx local engine)
LLM_MODEL=openai/Qwen3.6-35B-A3B-UD-MLX-4bit
LLM_API_KEY=zaqw
LLM_BASE_URL=http://127.0.0.1:8555/v1
# Optional override for agent-server containers (default: host.docker.internal)
# LLM_BASE_URL_CONTAINER=http://host.docker.internal:8555/v1

# OpenHands: agent-server image spawned per executor run (must match openhands-sdk)
OPENHANDS_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.21.1-python

# PostgreSQL persistence (workflow runs + LangGraph checkpointer)
# Prefer RUNS_DB_URL/LANGGRAPH_CHECKPOINT_DB_URL in all environments.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agent_graph
POSTGRES_USER=agent_graph
POSTGRES_PASSWORD=agent_graph
# RUNS_DB_URL=postgresql://agent_graph:agent_graph@127.0.0.1:5432/agent_graph
# LANGGRAPH_CHECKPOINT_DB_URL=postgresql://agent_graph:agent_graph@127.0.0.1:5432/agent_graph

# Optional: OpenHands GUI app (docker compose up openhands) — not used by the executor
# OPENHANDS_GUI_URL=http://localhost:3006

# Git clone timeout in seconds (planner and executor)
# GIT_CLONE_TIMEOUT=120

# OpenHands iteration limits
# PLANNER_MAX_ITERATIONS=80
# PLANNER_STATIC_CONTEXT_MAX_CHARS=8000
# Per-repo analysis: local LLM by default (set 1 to use OpenHands agent in Docker)
# PLANNER_USE_OPENHANDS=0
# Reuse one agent-server container; new conversation per repo (default on)
# OPENHANDS_REUSE_AGENT_SERVER=1
# EXECUTOR_MAX_ITERATIONS=120
# EXECUTOR_SIMPLE_MAX_ITERATIONS=60
# EXECUTOR_COMPLEX_MAX_ITERATIONS=500
# EXECUTOR_CONSTRAINED_ENABLED=1
# EXECUTOR_CONSTRAINED_MAX_FILES=3
# EXECUTOR_DISCOVERY_STRICT=0
# VERIFIER_RUN_TESTS=1
# VERIFIER_SKIP_LINT=0
# VERIFIER_TIMEOUT_SEC=300
# PR_ALLOW_HARD_FORCE_PUSH=1

# Executor: target repo to modify (can also pass via --repo CLI arg)
TARGET_REPO_PATH=

# Optional developer instructions for planner/executor (also: --prompt, --prompt-file)
# INPUT_PROMPT=Also fix email verified on the backend, not only the admin UI.

GITHUB_TOKEN=

# Deploy environment tag after push: env.{env}.branch.{branch} (also: --deploy-env, prompt)
# DEPLOY_ENV=dev

# PR creation (optional overrides)
# GITHUB_PR_BASE_BRANCH=main
# BITBUCKET_PR_BASE_BRANCH=master
# GIT_AUTHOR_NAME=pawel.lesneu
# GIT_AUTHOR_EMAIL=pawel.lesneu@dmetrics.com

# Platform selection (default: github)
# SOURCE_PLATFORM=github

BITBUCKET_TOKEN=
# API tokens: set JIRA_EMAIL (or BB_USERNAME) for REST API Basic auth; git uses x-bitbucket-api-token-auth automatically.
# Repository access tokens: Bearer-only — leave JIRA_EMAIL unset; token needs pullrequest:write for PR creation.
# BB_USERNAME=pawel.lesneu@dmetrics.com
# BITBUCKET_REVIEWERS=reviewer1,reviewer2

# Jira Configuration
JIRA_API_TOKEN=
JIRA_EMAIL=pawel.lesneu@dmetrics.com
ATLASSIAN_EMAIL=pawel.lesneu@dmetrics.com
JIRA_SITE=https://dmetrics.atlassian.net
JIRA_BASE_URL=https://dmetrics.atlassian.net
# JIRA_PROJECT=PROJ
JIRA_USE_MCP=1
JIRA_CLOUD_ID=https://your-site.atlassian.net

# MCP (see mcp.config.json)
# MCP_CONFIG_PATH=mcp.config.json
# MCP_USE_CURSOR_CONFIG=1
# MCP_CONTEXT7_ENABLED=1
# CONTEXT7_API_KEY=
# OPENHANDS_MCP_ENABLED=0
# OPENHANDS_MCP_HTTP_ONLY=1
# OPENHANDS_MCP_FILTER_REGEX=

# Optional: repository(s) for Jira/Bitbucket issue workflows.
# For Jira URLs, repos are detected from issue text (Admin app -> admin-ui, etc.)
# using BB_DEFAULT_OWNER — TARGET_REPO_PATH is NOT used (avoids GitHub test defaults).
# Comma-separated list for explicit multi-repo overrides:
# JIRA_REPO_PATH=https://bitbucket.org/myteam/admin-ui.git,https://bitbucket.org/myteam/account-settings.git
# BB_DEFAULT_OWNER=myteam   # Resolves admin-ui -> https://bitbucket.org/myteam/admin-ui.git
# BB_DEFAULT_REPO=myrepo
# JIRA_REPO_MAP=admin-ui=https://bitbucket.org/myteam/admin-ui.git,identity-hub=https://bitbucket.org/myteam/identity-hub.git
# GH_DEFAULT_OWNER=myteam
# GH_DEFAULT_REPO=myrepo

# Custom service-to-repo name mapping (comma-separated "keyword=repo_name" pairs)
# Used by RepoDetectorAgent to map service names in issue text to repo names.
# Example: REPO_SERVICE_MAP="admin app=admin-ui,identity hub=identity-hub"
# REPO_SERVICE_MAP=

# LLM repo detection: when keyword heuristics find nothing, send issue + developer
# prompt with the workspace repo catalog (Bitbucket/GitHub list) to pick target repos.
# REPO_LLM_DETECT=1
# REPO_LLM_MAX_CATALOG=400
